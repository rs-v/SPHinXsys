@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# ---- Required dependencies (must be available in the downstream environment) ----
find_dependency(Simbody CONFIG)
find_dependency(Eigen3 CONFIG)
find_dependency(TBB CONFIG)
find_dependency(Threads)
find_dependency(Boost REQUIRED)
find_dependency(spdlog CONFIG)

# ---- Optional: Boost.ProgramOptions (only required if it was found at build time) ----
if(@SPHINXSYS_HAS_BOOST_PROGRAM_OPTIONS@)
    find_dependency(Boost COMPONENTS program_options)
endif()

# ---- Optional: VTK (only required if the library was built with VTK support) ----
if(@SPHINXSYS_USE_VTK@)
    find_dependency(VTK REQUIRED COMPONENTS CommonCore CommonDataModel IOXML)
endif()

# ---- Import the exported targets ----
include("${CMAKE_CURRENT_LIST_DIR}/SPHinXsysTargets.cmake")

check_required_components(SPHinXsys)
